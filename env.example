# GitHub API Configuration
GITHUB_TOKEN=your_github_personal_access_token_here

# Gemini AI API Configuration (Required for AI-powered compatibility analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Database Configuration (if you plan to store analysis results)
# DATABASE_URL=your_database_url_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual API keys
# 3. Get GitHub token: https://github.com/settings/tokens (needs repo scope)
# 4. Get Gemini API key: https://makersuite.google.com/app/apikey
# 5. Restart your development server after adding the keys 